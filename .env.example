# Gemini qua endpoint tương thích OpenAI
GEMINI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SEC=45
LLM_MAX_TOKENS=1024
LLM_REASONING_EFFORT=minimal

# Trang admin: đặt một chuỗi ngẫu nhiên dài. Để trống = khoá toàn bộ route /admin.
ADMIN_TOKEN=
